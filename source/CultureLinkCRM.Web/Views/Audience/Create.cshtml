@model AudienceFormViewModel
@{ ViewData["Title"] = "New Audience"; }
<div class="page-toolbar mb-3">
    <h1 class="mb-0"><i class="bi bi-broadcast me-2"></i>New Audience</h1>
</div>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-broadcast me-2"></i>Audience Details</div>
        <div class="card-body">
            <div class="col-md-6">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-tags me-2"></i>Segments to combine (OR)</div>
        <div class="card-body">
            @foreach (var option in Model.SegmentOptions)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SegmentIds" value="@option.Value" id="seg-@option.Value" />
                    <label class="form-check-label" for="seg-@option.Value">@option.Text</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
</form>
