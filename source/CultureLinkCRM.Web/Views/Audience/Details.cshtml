@model Audience
@{
    ViewData["Title"] = Model.Name;
    var members = (IReadOnlyList<AudienceMemberRow>)ViewBag.Members;
}

<div class="page-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="mb-0 me-auto">@Model.Name</h1>
    <a asp-controller="Export" asp-action="Audience" asp-route-id="@Model.Id" class="btn btn-outline-primary">
        <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
    </a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete Audience</button>
    </form>
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-tags me-2"></i>Segments (OR)</div>
    <div class="card-body">
        @if (Model.SegmentLinks.Any())
        {
            foreach (var l in Model.SegmentLinks)
            {
                <span class="badge badge-tag me-1">@l.Segment?.Name</span>
            }
        }
        else
        {
            <span class="empty-state">No segments selected.</span>
        }
    </div>
</div>

<div class="card section-card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-people me-2"></i>Members</span>
        <span class="text-muted small">@members.Count matching row(s), household-deduplicated</span>
    </div>
    <div class="card-body">
        @if (members.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Kind</th><th>Name</th><th>Address</th><th>Phone</th><th>Email</th></tr></thead>
                <tbody>
                @foreach (var m in members)
                {
                    <tr>
                        <td>@m.Kind</td>
                        <td>@m.DisplayName</td>
                        <td>@m.Street1, @m.City @m.StateProvince @m.PostalCode @m.Country</td>
                        <td>@m.Phone</td>
                        <td>@m.Email</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <span class="empty-state">No matching members.</span>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
