@model ExportColumnPickerViewModel
@{ ViewData["Title"] = "Export to Excel"; }
<h1>Export to Excel</h1>
<p>Choose which columns to include (this selection applies to this export only).</p>

<form asp-action="@Model.FormAction" method="post">
    @Html.AntiForgeryToken()

    @if (Model.PersonFilter is not null)
    {
        <input type="hidden" name="Name" value="@Model.PersonFilter.Name" />
        <input type="hidden" name="City" value="@Model.PersonFilter.City" />
        <input type="hidden" name="SegmentId" value="@Model.PersonFilter.SegmentId" />
        <input type="hidden" name="NetworkId" value="@Model.PersonFilter.NetworkId" />
        <input type="hidden" name="AddedFrom" value="@Model.PersonFilter.AddedFrom?.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="AddedTo" value="@Model.PersonFilter.AddedTo?.ToString("yyyy-MM-dd")" />
    }
    @if (Model.OrganizationFilter is not null)
    {
        <input type="hidden" name="Name" value="@Model.OrganizationFilter.Name" />
        <input type="hidden" name="City" value="@Model.OrganizationFilter.City" />
        <input type="hidden" name="SegmentId" value="@Model.OrganizationFilter.SegmentId" />
        <input type="hidden" name="NetworkId" value="@Model.OrganizationFilter.NetworkId" />
        <input type="hidden" name="AddedFrom" value="@Model.OrganizationFilter.AddedFrom?.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="AddedTo" value="@Model.OrganizationFilter.AddedTo?.ToString("yyyy-MM-dd")" />
    }
    @if (Model.AudienceId is not null)
    {
        <input type="hidden" name="audienceId" value="@Model.AudienceId" />
    }

    @foreach (var col in Model.AvailableColumns)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="selectedColumnKeys" value="@col.Key" id="col-@col.Key" checked="@Model.SelectedColumnKeys.Contains(col.Key)" />
            <label class="form-check-label" for="col-@col.Key">@col.DisplayName</label>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Download .xlsx</button>
</form>
