@model Household
@{ ViewData["Title"] = "Delete Household"; }
<div class="card section-card" style="max-width: 32rem;">
    <div class="card-body">
        <h5 class="d-flex align-items-center gap-2 text-danger"><i class="bi bi-exclamation-triangle"></i>Delete Household</h5>
        <p>Are you sure you want to delete <strong>@Model.HouseholdName</strong>? This cannot be undone.</p>
        @if (Model.Members.Count > 0)
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-circle me-1"></i>This household has @Model.Members.Count member(s) attached and cannot be deleted until they are reassigned or unlinked.</div>
        }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
