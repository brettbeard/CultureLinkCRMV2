@model Network

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-2">
        <div class="col-md-5">
            <label class="form-label" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="NetworkType"></label>
            @Html.DropDownListFor(m => m.NetworkType, Html.GetEnumSelectList<NetworkType>(), new { @class = "form-select" })
        </div>
        <div class="col-md-4">
            <label class="form-label">Parent Network</label>
            <select asp-for="ParentNetworkId" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ParentOptions" class="form-select">
                <option value="">-- none --</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Index" class="btn btn-link mt-3">Cancel</a>
</form>
