@model Organization
@{
    ViewData["Title"] = Model.Name;
    var donorStatus = (DonorStatus)ViewBag.DonorStatus;
    var donations = (IReadOnlyList<Donation>)ViewBag.Donations;
    var orders = (IReadOnlyList<CurriculumOrder>)ViewBag.CurriculumOrders;
    var engagements = (IReadOnlyList<Engagement>)ViewBag.Engagements;
}
<h1>@Model.Name</h1>
<p><em>@Model.OrganizationType</em></p>
@if (User.IsInRole("Admin") || User.IsInRole("Superuser"))
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Delete</a>
}

<h4 class="mt-3">Addresses</h4>
<ul>
    @foreach (var a in Model.Addresses)
    {
        <li>@a.Type: @a.Street1, @a.City @a.StateProvince @a.PostalCode @a.Country</li>
    }
</ul>
<h4>Phones</h4>
<ul>
    @foreach (var p in Model.Phones)
    {
        <li>@p.Type: @p.Number</li>
    }
</ul>
<h4>Emails</h4>
<ul>
    @foreach (var e in Model.Emails)
    {
        <li>@e.Type: @e.Address</li>
    }
</ul>

<h4>Linked People</h4>
<ul>
    @foreach (var link in Model.PersonLinks)
    {
        <li><a asp-controller="Person" asp-action="Details" asp-route-id="@link.PersonId">@link.Person?.FullName</a> @(!string.IsNullOrWhiteSpace(link.RoleTitle) ? $"({link.RoleTitle})" : "")</li>
    }
</ul>

<h4>Networks</h4>
<ul>
    @foreach (var link in Model.NetworkLinks)
    {
        <li>@link.Network?.Name</li>
    }
</ul>

<h4>Segments</h4>
<p><strong>Donor status:</strong> @donorStatus</p>
<ul>
    @foreach (var a in Model.SegmentAssignments.Where(a => a.Segment != null && !a.Segment.IsComputed))
    {
        <li>@a.Segment!.Name</li>
    }
</ul>

<h4>Donations @if (User.IsInRole("Admin") || User.IsInRole("Superuser")) { <a asp-controller="Donation" asp-action="Create" asp-route-organizationId="@Model.Id" class="btn btn-sm btn-outline-primary">Add</a> }</h4>
<table class="table table-sm">
    <thead><tr><th>Date</th><th>Amount</th><th>Fund/Project</th></tr></thead>
    <tbody>
    @foreach (var d in donations)
    {
        <tr><td>@d.DonationDate.ToShortDateString()</td><td>@d.Amount.ToString("C")</td><td>@d.FundProjectDesignation</td></tr>
    }
    </tbody>
</table>

<h4>Curriculum Orders @if (User.IsInRole("Admin") || User.IsInRole("Superuser")) { <a asp-controller="CurriculumOrder" asp-action="Create" asp-route-organizationId="@Model.Id" class="btn btn-sm btn-outline-primary">Add</a> }</h4>
<table class="table table-sm">
    <thead><tr><th>Date</th><th>Quantity</th></tr></thead>
    <tbody>
    @foreach (var o in orders)
    {
        <tr><td>@o.OrderDate.ToShortDateString()</td><td>@o.Quantity</td></tr>
    }
    </tbody>
</table>

<h4>Engagements @if (User.IsInRole("Admin") || User.IsInRole("Superuser")) { <a asp-controller="Engagement" asp-action="Create" asp-route-organizationId="@Model.Id" class="btn btn-sm btn-outline-primary">Add</a> }</h4>
<table class="table table-sm">
    <thead><tr><th>Type</th><th>Start</th><th>End</th><th>Notes</th></tr></thead>
    <tbody>
    @foreach (var e in engagements)
    {
        <tr><td>@e.EngagementType?.Name</td><td>@e.StartDate.ToShortDateString()</td><td>@(e.EndDate?.ToShortDateString() ?? "(ongoing)")</td><td>@e.Notes</td></tr>
    }
    </tbody>
</table>

<a asp-action="Index">Back to list</a>
