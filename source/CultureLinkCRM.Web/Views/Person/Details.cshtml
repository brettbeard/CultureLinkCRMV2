@model Person
@{
    ViewData["Title"] = Model.FullName;
    var contact = (EffectiveContactInfo)ViewBag.EffectiveContact;
    var donorStatus = (DonorStatus)ViewBag.DonorStatus;
    var donations = (IReadOnlyList<Donation>)ViewBag.Donations;
    var orders = (IReadOnlyList<CurriculumOrder>)ViewBag.CurriculumOrders;
    var engagements = (IReadOnlyList<Engagement>)ViewBag.Engagements;
    var seminarAttendances = (IReadOnlyList<SeminarAttendance>)ViewBag.SeminarAttendances;
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Superuser");

    var addresses = (contact.Addresses.Any()
        ? contact.Addresses.Select(a => (Type: a.Type.ToString(), Line: $"{a.Street1}, {a.City} {a.StateProvince} {a.PostalCode} {a.Country}"))
        : contact.HouseholdAddresses.Select(a => (Type: a.Type.ToString(), Line: $"{a.Street1}, {a.City} {a.StateProvince} {a.PostalCode} {a.Country}"))).ToList();
    var phones = (contact.Phones.Any()
        ? contact.Phones.Select(p => (Type: p.Type.ToString(), Line: p.Number))
        : contact.HouseholdPhones.Select(p => (Type: p.Type.ToString(), Line: p.Number))).ToList();
    var emails = (contact.Emails.Any()
        ? contact.Emails.Select(e => (Type: e.Type.ToString(), Line: e.Address))
        : contact.HouseholdEmails.Select(e => (Type: e.Type.ToString(), Line: e.Address))).ToList();

    string DonorBadgeClass(DonorStatus status) => status switch
    {
        DonorStatus.Active => "badge-status-active",
        DonorStatus.Lapsed => "badge-status-lapsed",
        _ => "badge-status-none"
    };
}

<div class="page-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="mb-0 me-auto">@Model.FullName</h1>
    @if (canEdit)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</a>
    }
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-house-door me-2"></i>Household</div>
    <div class="card-body">
        @if (Model.Household is not null)
        {
            <a asp-controller="Household" asp-action="Details" asp-route-id="@Model.Household.Id">@Model.Household.HouseholdName</a>
        }
        else
        {
            <span class="empty-state">No household linked.</span>
        }
    </div>
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-person-lines-fill me-2"></i>Effective Contact Info</div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-4">
                <h6 class="text-uppercase small text-muted mb-2">
                    Addresses
                    @if (contact.AddressFromHousehold) { <span class="badge badge-tag">from household</span> }
                </h6>
                @if (addresses.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var a in addresses)
                        {
                            <li class="mb-1"><span class="badge badge-tag me-1">@a.Type</span> @a.Line</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="empty-state">No addresses on file.</span>
                }
            </div>
            <div class="col-md-4">
                <h6 class="text-uppercase small text-muted mb-2">
                    Phones
                    @if (contact.PhoneFromHousehold) { <span class="badge badge-tag">from household</span> }
                </h6>
                @if (phones.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var p in phones)
                        {
                            <li class="mb-1"><span class="badge badge-tag me-1">@p.Type</span> @p.Line</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="empty-state">No phones on file.</span>
                }
            </div>
            <div class="col-md-4">
                <h6 class="text-uppercase small text-muted mb-2">
                    Emails
                    @if (contact.EmailFromHousehold) { <span class="badge badge-tag">from household</span> }
                </h6>
                @if (emails.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var e in emails)
                        {
                            <li class="mb-1"><span class="badge badge-tag me-1">@e.Type</span> @e.Line</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="empty-state">No emails on file.</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-diagram-3 me-2"></i>Organizations &amp; Networks</div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <h6 class="text-uppercase small text-muted mb-2">Organizations</h6>
                @if (Model.OrganizationLinks.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var link in Model.OrganizationLinks)
                        {
                            <li class="mb-1">@link.Organization?.Name @if (!string.IsNullOrWhiteSpace(link.RoleTitle)) { <span class="text-muted">(@link.RoleTitle)</span> }</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="empty-state">No organizations linked.</span>
                }
            </div>
            <div class="col-md-6">
                <h6 class="text-uppercase small text-muted mb-2">Networks</h6>
                @if (Model.NetworkLinks.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var link in Model.NetworkLinks)
                        {
                            <li class="mb-1">@link.Network?.Name</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="empty-state">No networks linked.</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-tags me-2"></i>Segments</div>
    <div class="card-body">
        <p class="mb-2"><strong>Donor status:</strong> <span class="badge @DonorBadgeClass(donorStatus)">@donorStatus</span></p>
        @{
            var manualSegments = Model.SegmentAssignments.Where(a => a.Segment != null && !a.Segment.IsComputed).ToList();
        }
        @if (manualSegments.Any())
        {
            foreach (var a in manualSegments)
            {
                <span class="badge badge-tag me-1">@a.Segment!.Name</span>
            }
        }
        else
        {
            <span class="empty-state">No manual segments assigned.</span>
        }
    </div>
</div>

<div class="card section-card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-cash-coin me-2"></i>Donations</span>
        @if (canEdit)
        {
            <a asp-controller="Donation" asp-action="Create" asp-route-personId="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Add</a>
        }
    </div>
    <div class="card-body">
        @if (donations.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Date</th><th>Amount</th><th>Fund/Project</th></tr></thead>
                <tbody>
                @foreach (var d in donations)
                {
                    <tr><td>@d.DonationDate.ToShortDateString()</td><td>@d.Amount.ToString("C")</td><td>@d.FundProjectDesignation</td></tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <span class="empty-state">No donations recorded yet.</span>
        }
    </div>
</div>

<div class="card section-card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-journal-text me-2"></i>Curriculum Orders</span>
        @if (canEdit)
        {
            <a asp-controller="CurriculumOrder" asp-action="Create" asp-route-personId="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Add</a>
        }
    </div>
    <div class="card-body">
        @if (orders.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Date</th><th>Quantity</th><th>Linked Org</th></tr></thead>
                <tbody>
                @foreach (var o in orders)
                {
                    <tr><td>@o.OrderDate.ToShortDateString()</td><td>@o.Quantity</td><td>@o.LinkedOrganization?.Name</td></tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <span class="empty-state">No curriculum orders yet.</span>
        }
    </div>
</div>

<div class="card section-card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-calendar-event me-2"></i>Engagements</span>
        @if (canEdit)
        {
            <a asp-controller="Engagement" asp-action="Create" asp-route-personId="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Add</a>
        }
    </div>
    <div class="card-body">
        @if (engagements.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Type</th><th>Start</th><th>End</th><th>Notes</th></tr></thead>
                <tbody>
                @foreach (var e in engagements)
                {
                    <tr><td>@e.EngagementType?.Name</td><td>@e.StartDate.ToShortDateString()</td><td>@(e.EndDate?.ToShortDateString() ?? "(ongoing)")</td><td>@e.Notes</td></tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <span class="empty-state">No engagements recorded yet.</span>
        }
    </div>
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-mortarboard me-2"></i>Seminar Attendance</div>
    <div class="card-body">
        @if (seminarAttendances.Any())
        {
            <ul class="list-unstyled mb-0">
                @foreach (var a in seminarAttendances)
                {
                    <li class="mb-1"><a asp-controller="Seminar" asp-action="Details" asp-route-id="@a.SeminarId">@a.Seminar?.City @a.Seminar?.Year</a></li>
                }
            </ul>
        }
        else
        {
            <span class="empty-state">No seminar attendance recorded.</span>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
