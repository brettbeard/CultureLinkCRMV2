@model PersonFormViewModel

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="Id" />

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-person-vcard me-2"></i>Person Details</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label" asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" asp-for="MiddleName"></label>
                    <input asp-for="MiddleName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" asp-for="Suffix"></label>
                    <input asp-for="Suffix" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Household</label>
                    <select asp-for="HouseholdId" asp-items="Model.HouseholdOptions" class="form-select">
                        <option value="">-- none --</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-geo-alt me-2"></i>Addresses</div>
        <div class="card-body">
            @if (Model.Addresses.Count == 0)
            {
                <span class="empty-state">No address slots available yet &mdash; save the record, then edit it to add addresses.</span>
            }
            @Html.EditorFor(m => m.Addresses)
        </div>
    </div>

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-telephone me-2"></i>Phones</div>
        <div class="card-body">
            @if (Model.Phones.Count == 0)
            {
                <span class="empty-state">No phone slots available yet &mdash; save the record, then edit it to add phones.</span>
            }
            @Html.EditorFor(m => m.Phones)
        </div>
    </div>

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-envelope me-2"></i>Emails</div>
        <div class="card-body">
            @if (Model.Emails.Count == 0)
            {
                <span class="empty-state">No email slots available yet &mdash; save the record, then edit it to add emails.</span>
            }
            @Html.EditorFor(m => m.Emails)
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
</form>
