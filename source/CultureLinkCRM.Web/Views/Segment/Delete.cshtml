@model Segment
@{ ViewData["Title"] = "Delete Segment"; }
<div class="card section-card" style="max-width: 32rem;">
    <div class="card-body">
        <h5 class="d-flex align-items-center gap-2 text-danger"><i class="bi bi-exclamation-triangle"></i>Delete Segment</h5>
        <p>Are you sure you want to delete <strong>@Model.Name</strong>? This cannot be undone.</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
