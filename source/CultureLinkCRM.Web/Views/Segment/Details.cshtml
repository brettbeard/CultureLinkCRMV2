@model Segment
@{
    ViewData["Title"] = Model.Name;
    var canEdit = !Model.IsComputed && (User.IsInRole("Admin") || User.IsInRole("Superuser"));
}

<div class="page-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="mb-0">@Model.Name</h1>
    <span class="badge badge-tag">@(Model.IsComputed ? "Computed (system)" : "Manual")</span>
    <div class="ms-auto d-flex gap-2">
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</a>
        }
    </div>
</div>

@if (Model.IsComputed)
{
    <div class="alert alert-warning"><i class="bi bi-info-circle me-1"></i>This is a system-computed segment (donor status). It cannot be edited, deleted, or manually assigned.</div>
}

<div class="card section-card">
    <div class="card-header"><i class="bi bi-people me-2"></i>Assigned Contacts</div>
    <div class="card-body">
        @if (Model.Assignments.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Contact</th><th>Date Assigned</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in Model.Assignments)
                {
                    <tr>
                        <td>
                            @if (a.PersonId is not null)
                            {
                                <a asp-controller="Person" asp-action="Details" asp-route-id="@a.PersonId">@a.Person?.FullName</a>
                            }
                            else
                            {
                                <a asp-controller="Organization" asp-action="Details" asp-route-id="@a.OrganizationId">@a.Organization?.Name</a>
                            }
                        </td>
                        <td>@a.DateAssigned.ToShortDateString()</td>
                        <td>
                            @if (canEdit)
                            {
                                <form asp-action="Unassign" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="segmentId" value="@Model.Id" />
                                    <input type="hidden" name="assignmentId" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <span class="empty-state">No contacts assigned yet.</span>
        }
    </div>
</div>

@if (canEdit)
{
    <div class="card section-card">
        <div class="card-header"><i class="bi bi-person-plus me-2"></i>Assign a Person</div>
        <div class="card-body">
            <form asp-action="Assign" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="segmentId" value="@Model.Id" />
                <div class="col-md-4">
                    <select name="personId" class="form-select" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.PersonOptions">
                        <option value="">-- select --</option>
                    </select>
                </div>
                <div class="col-md-2"><button type="submit" class="btn btn-secondary">Assign</button></div>
            </form>
        </div>
    </div>

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-building-add me-2"></i>Assign an Organization</div>
        <div class="card-body">
            <form asp-action="Assign" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="segmentId" value="@Model.Id" />
                <div class="col-md-4">
                    <select name="organizationId" class="form-select" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.OrganizationOptions">
                        <option value="">-- select --</option>
                    </select>
                </div>
                <div class="col-md-2"><button type="submit" class="btn btn-secondary">Assign</button></div>
            </form>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
