@model Segment
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="Id" />

    <div class="card section-card">
        <div class="card-header"><i class="bi bi-tag me-2"></i>Segment Details</div>
        <div class="card-body">
            <div class="col-md-6">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
</form>
