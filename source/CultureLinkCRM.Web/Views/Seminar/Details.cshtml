@model Seminar
@{
    ViewData["Title"] = $"{Model.City} {Model.Year}";
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Superuser");
}

<div class="page-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="mb-0 me-auto">@Model.City @Model.Year</h1>
    @if (canEdit)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</a>
    }
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-mortarboard me-2"></i>Seminar Details</div>
    <div class="card-body">
        <strong>Parent seminar:</strong>
        @if (Model.ParentSeminar is not null)
        {
            <a asp-action="Details" asp-route-id="@Model.ParentSeminar.Id">@Model.ParentSeminar.City @Model.ParentSeminar.Year</a>
        }
        else
        {
            <span class="text-muted">(none)</span>
        }
    </div>
</div>

<div class="card section-card">
    <div class="card-header"><i class="bi bi-people me-2"></i>Attendees</div>
    <div class="card-body">
        @if (Model.Attendances.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Person</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in Model.Attendances)
                {
                    <tr>
                        <td><a asp-controller="Person" asp-action="Details" asp-route-id="@a.PersonId">@a.Person?.FullName</a></td>
                        <td>
                            @if (canEdit)
                            {
                                <form asp-action="RemoveAttendance" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="seminarId" value="@Model.Id" />
                                    <input type="hidden" name="attendanceId" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <span class="empty-state">No attendees recorded yet.</span>
        }
    </div>
</div>

@if (canEdit)
{
    <div class="card section-card">
        <div class="card-header"><i class="bi bi-person-plus me-2"></i>Record Attendance</div>
        <div class="card-body">
            <form asp-action="RecordAttendance" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="seminarId" value="@Model.Id" />
                <div class="col-md-4">
                    <select name="personId" class="form-select" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.PersonOptions">
                        <option value="">-- select --</option>
                    </select>
                </div>
                <div class="col-md-2"><button type="submit" class="btn btn-secondary">Record Attendance</button></div>
            </form>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
