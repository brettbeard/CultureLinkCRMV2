@model Seminar
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label" asp-for="City"></label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label" asp-for="Year"></label>
            <input asp-for="Year" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Parent Seminar</label>
            <select asp-for="ParentSeminarId" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ParentOptions" class="form-select">
                <option value="">-- none --</option>
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Index" class="btn btn-link mt-3">Cancel</a>
</form>
