@model SettingsViewModel
@{ ViewData["Title"] = "Settings"; }
<h1>Settings</h1>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<form asp-action="Index" method="post" class="col-md-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="LapsedDonorThresholdMonths">Lapsed donor threshold (months)</label>
        <input asp-for="LapsedDonorThresholdMonths" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
