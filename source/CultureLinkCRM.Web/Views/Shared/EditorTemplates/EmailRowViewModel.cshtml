@model CultureLinkCRM.Web.Models.EmailRowViewModel
<div class="row g-2 align-items-end border rounded p-2 mb-2">
    <div class="col-md-3">
        <label class="form-label">Type</label>
        @Html.DropDownListFor(m => m.Type, Html.GetEnumSelectList<CultureLinkCRM.Core.Enums.EmailType>(), new { @class = "form-select" })
    </div>
    <div class="col-md-2 form-check ms-2">
        <input asp-for="IsPrimary" class="form-check-input" />
        <label class="form-check-label" asp-for="IsPrimary">Primary</label>
    </div>
    <div class="col-md-6">
        <label class="form-label">Email address</label>
        <input asp-for="Address" class="form-control" type="email" />
    </div>
</div>
