@model CultureLinkCRM.Web.Models.PhoneRowViewModel
<div class="row g-2 align-items-end border rounded p-2 mb-2">
    <div class="col-md-3">
        <label class="form-label">Type</label>
        @Html.DropDownListFor(m => m.Type, Html.GetEnumSelectList<CultureLinkCRM.Core.Enums.PhoneType>(), new { @class = "form-select" })
    </div>
    <div class="col-md-2 form-check ms-2">
        <input asp-for="IsPrimary" class="form-check-input" />
        <label class="form-check-label" asp-for="IsPrimary">Primary</label>
    </div>
    <div class="col-md-6">
        <label class="form-label">Number (international format, e.g. +1 555 123 4567)</label>
        <input asp-for="Number" class="form-control" />
    </div>
</div>
