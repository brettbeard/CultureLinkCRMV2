<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CultureLink CRM</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Open+Sans:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CultureLinkCRM.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function () {
                if (window.localStorage.getItem("clcrm-sidebar-collapsed") === "1" && window.innerWidth >= 992) {
                    document.body.classList.add("sidebar-collapsed");
                }
            })();
        </script>
        <div class="app-wrapper">
            <partial name="_Sidebar" />
            <div class="sidebar-backdrop" data-sidebar-backdrop></div>
            <nav class="app-header">
                <button type="button" class="sidebar-toggle-btn" data-sidebar-toggle aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <ol class="breadcrumb app-breadcrumb ms-2 mb-0 flex-grow-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                </ol>
                <div class="dropdown">
                    <button class="btn btn-sm d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle fs-5"></i>
                        <span class="d-none d-sm-inline">@User.Identity!.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right me-2"></i>Log out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>
            <main class="app-main">
                <div class="app-content-header">
                    @if (TempData["Error"] is string errorMessage)
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                </div>
                <div class="app-content">
                    @RenderBody()
                </div>
            </main>
            <footer class="app-footer">
                &copy; 2026 - CultureLink CRM
            </footer>
        </div>
    }
    else
    {
        <header class="border-bottom bg-white">
            <div class="container py-3 d-flex align-items-center gap-2">
                <i class="bi bi-compass brand-mark fs-3"></i>
                <span class="fs-4"><span class="brand-culture">Culture</span><span class="brand-link">Link</span> CRM</span>
            </div>
        </header>
        <div class="container py-4">
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
