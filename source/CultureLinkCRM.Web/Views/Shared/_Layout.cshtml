@* Placeholder branding (Ref: FR-14): real logo/colors/fonts must be sourced from culturelinkinc.org before go-live; not guessed here. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CultureLink CRM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CultureLinkCRM.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CultureLink CRM</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Person" asp-action="Index">People</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Household" asp-action="Index">Households</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Organization" asp-action="Index">Organizations</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Network" asp-action="Index">Networks</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Segment" asp-action="Index">Segments</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Seminar" asp-action="Index">Seminars</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Audience" asp-action="Index">Audiences</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="UserAdmin" asp-action="Index">Users</a></li>
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Settings" asp-action="Index">Settings</a></li>
                            }
                        </ul>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
                            @Html.AntiForgeryToken()
                            <span class="navbar-text text-white me-2">@User.Identity!.Name</span>
                            <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CultureLink CRM
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
