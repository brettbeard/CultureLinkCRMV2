@model CreateUserViewModel
@{ ViewData["Title"] = "New User"; }
<h1>New User</h1>
<form asp-action="Create" method="post" class="col-md-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Role"></label>
        @Html.DropDownListFor(m => m.Role, Html.GetEnumSelectList<UserRole>(), new { @class = "form-select" })
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
