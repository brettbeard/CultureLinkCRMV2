@model CreateUserViewModel
@{ ViewData["Title"] = "New User"; }
<div class="page-toolbar mb-3">
    <h1 class="mb-0"><i class="bi bi-person-plus me-2"></i>New User</h1>
</div>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <div class="card section-card" style="max-width: 32rem;">
        <div class="card-header"><i class="bi bi-person-badge me-2"></i>User Details</div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Role"></label>
                @Html.DropDownListFor(m => m.Role, Html.GetEnumSelectList<UserRole>(), new { @class = "form-select" })
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
</form>
