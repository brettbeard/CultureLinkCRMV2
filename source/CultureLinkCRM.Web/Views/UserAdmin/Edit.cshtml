@model UpdateUserRoleViewModel
@{ ViewData["Title"] = "Edit User"; }
<h1>Edit User</h1>
<form asp-action="Edit" method="post" class="col-md-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input value="@Model.Email" class="form-control" disabled />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Role"></label>
        @Html.DropDownListFor(m => m.Role, Html.GetEnumSelectList<UserRole>(), new { @class = "form-select" })
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
